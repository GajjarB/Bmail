{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "0.1.0",
  "identifier": "dev.sift.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Local-first email triage",
    "longDescription": "Reads your mailboxes on this machine, decides what needs you, and tracks lifecycle mail. Nothing leaves the computer."
  }
}
