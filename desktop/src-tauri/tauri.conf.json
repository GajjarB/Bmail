{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bmail",
  "version": "0.1.1",
  "identifier": "dev.bmail.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Bmail",
    "copyright": "MIT licence",
    "homepage": "https://github.com/GajjarB/Bmail",
    "licenseFile": "../../LICENSE",
    "category": "Productivity",
    "shortDescription": "Local-first email triage",
    "longDescription": "Reads your mailboxes on this machine, decides what needs you, and tracks lifecycle mail. Nothing leaves the computer.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "resources": [
      "engine/"
    ]
  }
}
