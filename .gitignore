# Python
__pycache__/
*.py[cod]
*.egg-info/
# Root-anchored: desktop/dist is the Tauri shell's fallback page and is tracked.
/build/
/dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local agent/editor state
.idea/
.vscode/

# Bmail runtime data — never commit mail, tokens or models
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.mbox
*.eml
credentials.json
token.json
config.toml
models/
out/

# Rust / Tauri build output
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Release builds: the frozen engine and the desktop bundles are artifacts.
desktop/src-tauri/binaries/
desktop/src-tauri/engine/
desktop/node_modules/
desktop/src-tauri/tauri.updater.local.json

# Film takes: gigabytes of frames, and music that is not ours to pass on
/film/
